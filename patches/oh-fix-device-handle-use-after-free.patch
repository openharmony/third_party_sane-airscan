                                                 beginning */
     bool                 read_24_to_8;       /* Resample 24 to 8 bits */
     filter               *read_filters;      /* Chain of image filters */
+
+    /* UAF protection: delayed free + entry validation */
+    bool                 closed;             /* device_close has been called */
+    int                  scan_in_progress;   /* sane_read/sane_start in flight */
+    pthread_cond_t       close_cond;         /* Signalled when scan_in_progress
+                                                reaches zero */
 };
 
 /* Static variables
@@ -231,6 +237,9 @@ device_new (zeroconf_devinfo *devinfo)
     dev->proto_ctx.http = http_client_new(dev->log, dev);
 
     pthread_cond_init(&dev->stm_cond, NULL);
+    pthread_cond_init(&dev->close_cond, NULL);
+    dev->closed = false;
+    dev->scan_in_progress = 0;
 
     dev->read_pollable = pollable_new();
     dev->read_queue = http_data_queue_new();
@@ -292,6 +301,7 @@ device_free (device *dev, const char *log_msg)
     mem_free((char*) dev->proto_ctx.location);
 
     pthread_cond_destroy(&dev->stm_cond);
+    pthread_cond_destroy(&dev->close_cond);
     image_decoder_free_all(dev->decoders);
     http_data_queue_free(dev->read_queue);
     pollable_free(dev->read_pollable);
@@ -1156,6 +1166,50 @@ device_log_ctx (device *dev)
     return dev ? dev->log : NULL;
 }
 
+/* Validate that a device handle is still alive (not closed).
+ * Must be called with eloop_mutex held.
+ */
+bool
+device_validate (device *dev)
+{
+    if (dev == NULL) {
+        return false;
+    }
+    return ptr_array_find(device_table, dev) >= 0;
+}
+
+/* Increment scan-in-progress counter.
+ * Must be called with eloop_mutex held.
+ */
+void
+device_scan_begin (device *dev)
+{
+    dev->scan_in_progress++;
+}
+
+/* Decrement scan-in-progress counter and wake device_close if waiting.
+ * Must be called with eloop_mutex held.
+ */
+void
+device_scan_end (device *dev)
+{
+    dev->scan_in_progress--;
+    if (dev->closed && dev->scan_in_progress == 0) {
+        pthread_cond_broadcast(&dev->close_cond);
+    }
+}
+
+/* Check if device has been closed (for lock-free callers like sane_cancel).
+ */
+bool
+device_is_closed (device *dev)
+{
+    if (dev == NULL) {
+        return true;
+    }
+    return __atomic_load_n(&dev->closed, __ATOMIC_SEQ_CST);
+}
+
 /* Open a device
  */
 device*
@@ -1225,6 +1279,17 @@ device_close (device *dev, const char *log_msg)
 
     /* Close the device */
     device_stm_state_set(dev, DEVICE_STM_CLOSED);
+
+    /* Mark as closed and remove from device_table so that
+     * device_validate() will reject subsequent sane_* calls */
+    dev->closed = true;
+    ptr_array_del(device_table, ptr_array_find(device_table, dev));
+
+    /* Wait until all in-flight sane_read/sane_start calls exit */
+    while (dev->scan_in_progress > 0) {
+        eloop_cond_wait(&dev->close_cond);
+    }
+
     device_free(dev, log_msg);
 }
 
